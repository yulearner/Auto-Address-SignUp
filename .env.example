# ============================================================
# Auto Checkin 环境变量示例
#
# 使用方法：
#   复制本文件为 .env，填入各站点的账号密码；
#   .env 已加入 .gitignore，不会被提交；
#   也可不填，改用 `python main.py --manual-login --site <名称>` 手动登录（密码不落盘）。
#
# 注意：账号密码仅通过环境变量读取，禁止写入任何 yaml / 代码 / 日志。
# ============================================================

# ---- WindHub  (windhub.cc) ----
WINDHUB_USERNAME=your_email@example.com
WINDHUB_PASSWORD=your_password

# ---- ZeroCat  (zero.cat) ----
ZEROCAT_USERNAME=your_email@example.com
ZEROCAT_PASSWORD=your_password

# ---- Kuaipao  (kuaipao.ai) ----
KUAIPAO_USERNAME=your_email@example.com
KUAIPAO_PASSWORD=your_password

# ---- 42 API   (api.42x.shop) ----
API42X_USERNAME=your_email@example.com
API42X_PASSWORD=your_password

# ---- Elysiver (elysiver.h-e.top) ----
ELYSIVER_USERNAME=your_email@example.com
ELYSIVER_PASSWORD=your_password

# ---- Mofas    (www.mofas.one) ----
MOFAS_USERNAME=your_email@example.com
MOFAS_PASSWORD=your_password

# ---- Yangwj   (ai.yangwj.me) ----
YANGWJ_USERNAME=your_email@example.com
YANGWJ_PASSWORD=your_password

# ---- Huan666  (ai.huan666.de) ----
HUAN666_USERNAME=your_email@example.com
HUAN666_PASSWORD=your_password

# ---- AndRouter(and-router.top) ----
ANDROUTER_USERNAME=your_email@example.com
ANDROUTER_PASSWORD=your_password
